{
  "name": "dashboard-solid",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "node scripts/start.ts",
    "server": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm i18n:check && pnpm test",
    "lint": "eslint .",
    "i18n:check": "node scripts/i18n-check.ts",
    "game:update": "node scripts/game-update.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@solid-primitives/i18n": "^2.2.1",
    "acorn": "8.18.0",
    "esbuild": "0.28.2",
    "hono": "^4.13.14",
    "solid-js": "^1.9.17",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
