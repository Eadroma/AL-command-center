{
  "name": "adventureland-command-center",
  "private": true,
  "version": "0.1.0",
  "description": "Local Adventure Land dashboard, character scripts and in-game interfaces",
  "engines": { "node": ">=24 <25" },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm --dir dashboard-v2 dev",
    "build": "pnpm --dir dashboard-v2 build",
    "lint": "pnpm --dir dashboard-v2 lint",
    "test": "pnpm --dir dashboard-v2 test",
    "test:combat": "node --test tests/combat.test.cjs tests/public-repository.test.mjs",
    "test:smoke": "pnpm --dir dashboard-v2 exec node --import tsx ../tools/smoke-dashboard.mjs",
    "audit:public": "node tools/audit-public.mjs",
    "export:public": "node tools/prepare-public.mjs"
  }
}
